<header class="actor-header ev5-header">
  <div class="ev5-identity">
    <img class="ev5-portrait" data-action="editImage" data-edit="img" src="{{img}}" alt="{{name}}">
    <div class="ev5-identity-text">
      <span class="ev5-eyebrow">VAMPIRE · THE MASQUERADE</span>
      {{#if locked}}<h1>{{name}}</h1>{{else}}<input class="charname" name="name" type="text" value="{{name}}" aria-label="Nome do personagem">{{/if}}
      <span class="ev5-clan">{{#if clan}}{{clan.name}}{{else}}Clã não definido{{/if}}</span>
    </div>
    <button type="button" class="ev5-xp-pill" data-action="tab" data-group="primary" data-tab="advancement" title="Abrir evolução com XP"><strong>{{ev5XP}}</strong><span>XP disponível</span></button>
  </div>
  <div class="ev5-resources">
    <div class="ev5-resource">{{> "systems/wod5e/display/shared/actors/parts/health.hbs"}}</div>
    <div class="ev5-resource">{{> "systems/wod5e/display/shared/actors/parts/willpower.hbs"}}</div>
    <div class="ev5-resource"><label class="field-header resource-label">{{localize "WOD5E.VTM.Hunger"}}</label><div class="ev5-hunger">{{> "systems/wod5e/display/vtm/actors/parts/hunger.hbs"}}{{> "systems/wod5e/display/vtm/actors/parts/rouse.hbs"}}</div></div>
    <div class="ev5-resource"><label class="field-header resource-label">{{localize "WOD5E.VTM.Humanity"}}</label>{{> "systems/wod5e/display/vtm/actors/parts/humanity.hbs"}}</div>
  </div>
</header>
